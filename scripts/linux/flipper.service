[Unit]
Description=Flipper - lancement automatique
After=network-online.target docker.service graphical-session.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/playfield
ExecStart=/opt/playfield/scripts/linux/start_playfield.sh
ExecStop=/opt/playfield/scripts/linux/stop_playfield.sh
Environment=FLIPPER_KIOSK=1
Environment=FLIPPER_MANAGED_KIOSK=1
Environment=FLIPPER_BUTTON_SOURCE=esp32

[Install]
WantedBy=default.target
